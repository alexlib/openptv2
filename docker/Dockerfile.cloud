# Headless BATCH image for the cloud (Google Cloud Run / GCE, any container
# host). Free-threaded CPython 3.14t, no GUI. Parallelize across cores with
# multiprocessing — each worker is its own process, so the compiled OpenMP
# kernels do the heavy lifting regardless of the GIL.
#
#   docker build -f Dockerfile.cloud -t openptv2-cloud .
#   # smoke test on the baked demo (default pipeline):
#   docker run --rm openptv2-cloud sh -c \
#     "cp -r /demo/test_cavity /tmp/c && cd /tmp/c && \
#      openptv2-batch parameters_Run1.yaml 10001 10004"
#   # smoke test a non-default plugin (image-splitter dataset):
#   docker run --rm openptv2-cloud sh -c \
#     "cp -r /demo/test_splitter /tmp/s && cd /tmp/s && \
#      openptv2-batch parameters_Run1.yaml 1000001 1000002 \
#      --sequence-plugin splitter_sequence --tracking-plugin splitter_tracking"
#   # your own data:
#   docker run --rm -v "$PWD:/data" openptv2-cloud \
#     openptv2-batch /data/<exp>/parameters_Run1.yaml <first> <last>
#
# MEASURED (docs/cloud-batch.md): PYTHON_GIL=0 is NOT faster for this batch —
# a single-process run is ~25% SLOWER than with the GIL on, because the speed
# comes from the compiled Cython/OpenMP kernels, not from Python-level threads.
# The GIL is left ENABLED by default here (the kernels re-enable it on import
# anyway, since they don't yet *declare* free-threading safety). Set
# PYTHON_GIL=0 only to experiment; revisit once the modules declare Py_mod_gil.

FROM ghcr.io/astral-sh/uv:bookworm-slim

# build-essential: compile the Cython extensions (and traits) for 3.14t.
# libgomp1 stays at runtime for the OpenMP kernels (built with -fopenmp).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Pin the free-threaded interpreter at a fixed path so the venv is portable.
ENV UV_PYTHON_INSTALL_DIR=/opt/pyft \
    UV_LINK_MODE=copy
RUN uv python install 3.14t

WORKDIR /app
COPY . /app

# Default (headless batch) runtime into an isolated venv. requires-python allows
# 3.14; no GUI extras here. Non-editable install = the same "cloud-like" command
# documented in docs/cloud-batch.md: the compiled kernels land in site-packages,
# so /app is not needed at runtime.
RUN uv venv --python 3.14t /opt/venv \
    && VIRTUAL_ENV=/opt/venv uv pip install --no-cache .

# Baked demos for a zero-data smoke test: test_cavity (default pipeline) and
# test_splitter (exercises the built-in splitter_sequence/splitter_tracking
# plugins, proving plugin support ships in this image with no extra data).
RUN mkdir -p /demo && cp -r /app/test_data/test_cavity /demo/test_cavity \
    && cp -r /app/test_data/test_splitter /demo/test_splitter

# GIL left at its default (enabled). Run with `-e PYTHON_GIL=0` to force it off
# — see the MEASURED note above before you do.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1
VOLUME ["/data"]
WORKDIR /data

CMD ["openptv2-batch", "--help"]
